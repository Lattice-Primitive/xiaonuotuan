<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="secret.xml"/>
        <exclude domain="sharedpref" path="auth.xml"/>
        <exclude domain="sharedpref" path="token.xml"/>
        <exclude domain="database" path="sensitive.db"/>
        <exclude domain="file" path="cache/"/>
        <exclude domain="file" path="tmp/"/>
        <exclude domain="no_backup" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="secret.xml"/>
        <exclude domain="sharedpref" path="auth.xml"/>
        <exclude domain="sharedpref" path="token.xml"/>
        <exclude domain="database" path="sensitive.db"/>
        <exclude domain="file" path="cache/"/>
        <exclude domain="file" path="tmp/"/>
        <exclude domain="no_backup" path="."/>
    </device-transfer>
</data-extraction-rules>
